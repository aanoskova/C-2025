//Дан текст. Написать программу,печатающую только нечетные строки введенного текста. 

#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
int main()
{
    FILE* aa;
    FILE* bb;
    fopen_s(&aa, "text.txt", "r");
    fopen_s(&bb, "read.txt", "w");
    char c;
    int n = 1;
    while ((c = fgetc(aa)) != EOF) {
        if (c == '\n') {
            n = n + 1;
        }
        if (n % 2 == 1) {
            fputc(c, bb);
        }
    }
    fclose(aa);
    fclose(bb);
    return 0;
}





